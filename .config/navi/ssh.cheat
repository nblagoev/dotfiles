% ssh, resident-key
# generate resident key
ssh-keygen -t ed25519-sk -O resident -O verify-required -O application=ssh:auth
# sign a file
ssh-keygen -Y sign -f ~/.ssh/id_ed25519_sk.pub -n reason myfile.txt
# verify a file signature (needs an "allowed signers" file mapping identity -> pubkey)
echo "you@example.com $(cat ~/.ssh/id_ed25519_sk.pub)" > allowed_signers
ssh-keygen -Y verify -f allowed_signers -I you@example.com -n reason -s myfile.txt.sig < myfile.txt
