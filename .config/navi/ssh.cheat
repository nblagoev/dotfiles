% ssh, resident-key
# generate resident key
ssh-keygen -t ed25519-sk -O resident -O verify-required -O application=ssh:auth

% ssh, resident-key, restore
# Restore resident keys from a connected FIDO authenticator into ~/.ssh.
cd "$HOME/.ssh" && ssh-keygen -K

% ssh, sign
# sign a file
$ key_file: fd --type f --extension pub . "$HOME/.ssh"
$ file: fd --type f --hidden --exclude .git
ssh-keygen -Y sign -f <key_file> -n <namespace> <file>

% ssh, verify
# verify a file signature (needs an "allowed signers" file mapping identity -> pubkey)
$ public_key: fd --type f --extension pub . "$HOME/.ssh"
$ file: fd --type f --hidden --exclude .git
# The identity must match the left-hand field in allowed_signers, usually your email.
$ identity: git config --global --includes --get user.email
signer="<identity> $(cat "<public_key>")"
grep -qxF "$signer" allowed_signers || printf '%s\n' "$signer" >> allowed_signers
ssh-keygen -Y verify -f allowed_signers -I <identity> -n <namespace> -s <file>.sig < <file>
